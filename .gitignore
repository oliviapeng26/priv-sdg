.DS_Store
/data
/synthetic_data

# virtualenvs (the GPU workstation uses venv/ rather than conda)
venv/
.venv/
env/

# synthcity's internal cache for plugins (regenerable; never commit)
sdg/workspace/
workspace/
workspace_*/
**/workspace_*/

# tapas attack caches (memoised shadow datasets + pickled threat models; large
# and fully regenerable). cache_LEGACY/ holds the pre-2026-08-16 laptop-CPU runs,
# kept locally for reference but never committed - 696 MB, mostly PrivBayes.
cache/
cache_*/
__pycache__/

# aim bin-count sweep: per-setting synthetic CSVs (the results CSV/log/PNG are kept)
sdg/aim_tuning/synthetic/

# per-run script logs. Rewritten on every invocation and carrying nothing the
# result CSVs don't already record, so they only ever show up as noise in
# git status. The *_LEGACY logs already committed stay tracked - this does not
# untrack them.
sdg/generate_runs_log.txt
evaluation/eval_fidelity_log.txt
evaluation/eval_utility_log.txt
results/smartnoise/generate_smartnoise_log.txt
benchmark_tapas/results/convergence/convergence_check_tstr_log.txt
benchmark_tapas/results/pilot_counts/pilot_counts_log.txt
benchmark_tapas/results/pilot_counts/extra_counts_log.txt
benchmark_tapas/results/pilot_counts/extra_counts_nohup.out
